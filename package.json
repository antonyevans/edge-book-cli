{
  "name": "edge-book",
  "version": "0.8.1",
  "description": "Run your own Edge Book agent and connect it to the hosted reader.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "edge-book": "dist/edge-book.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.ts",
    "harness": "node bin/edge-book.js harness two-agent",
    "harness:e2e": "node scripts/convergence-e2e.ts",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke-2agent.ts",
    "smoke:host": "node scripts/smoke-2agent.ts --host"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "install": {
      "npmSpec": "edge-book",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.5.22"
    },
    "compat": {
      "pluginApi": ">=2026.5.22"
    }
  },
  "files": [
    "dist",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonyevans/edge-book-cli.git"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
